---
import SunStudy from "../../../components/concepts/SunStudy.astro";
import ProvenanceFigure from "../../../components/media/ProvenanceFigure.astro";
import type { Lang } from "../../../i18n/config";
import Page from "../../../layouts/Page.astro";
import { langPaths } from "../../../lib/content";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
---

<Page route="offPlan" lang={lang}>
