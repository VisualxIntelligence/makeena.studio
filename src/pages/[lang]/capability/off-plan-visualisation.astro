---
import Axonometric from "../../../components/concepts/Axonometric.astro";
import SunStudy from "../../../components/concepts/SunStudy.astro";
import type { Lang } from "../../../i18n/config";
import Page from "../../../layouts/Page.astro";
import { langPaths } from "../../../lib/content";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
---

