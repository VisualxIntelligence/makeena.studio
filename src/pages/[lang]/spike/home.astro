---
// Phase 0 spikes (a) and (c): a home-like page to navigate from and to.
import { Picture } from "astro:assets";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import SpikeNav from "../../../components/global/SpikeNav.astro";
import { spikeCopy } from "../../../spikes/copy";
import heroDusk from "../../../../design/renders/MKN-TWR-CAM01-DUSK.jpg";

export { spikePaths as getStaticPaths } from "../../../spikes/paths";

const lang = Astro.params.lang as "en" | "ar";
const t = spikeCopy[lang];
---

<BaseLayout chrome={false} router={false} title="Spike · Home" lang={lang}>
  <SpikeNav slot="header" lang={lang} />
  {t.draftNote && (
    <p class="wrap label draft" lang="en" dir="ltr">
      {t.draftNote}
    </p>
  )}
  <section class="hero">
    <div class="wrap hero__inner">
      <p class="label">
        <span dir="ltr">00</span> · {t.eyebrowPlace} · <span dir="ltr">QFC 04998</span>
      </p>
      <h1 class="display">{t.headline}</h1>
      <p class="lede">{t.lede}</p>
      <p class="ctas">
        <a href={`/${lang}/spike/method/`}>{t.cta}</a>
      </p>
    </div>
    <figure class="wrap hero__media">
      <Picture
        src={heroDusk}
        widths={[828, 1280, 1800]}
        sizes="(min-width: 1280px) 1232px, calc(100vw - 48px)"
        formats={["avif", "webp"]}
        alt={t.heroAlt}
        loading="eager"
        fetchpriority="high"
      />
      <figcaption class="label">
        {t.generated} · <span dir="ltr">MKN-TWR-CAM01-DUSK</span>
      </figcaption>
    </figure>
  </section>
  <section class="wrap band" id="position">
    <p class="label">
      <span dir="ltr">01</span> · {t.positionLabel}
    </p>
    <p>{t.position}</p>
  </section>
</BaseLayout>

<style>
  .draft {
    padding-block: 8px;
    color: var(--color-muted);
  }

  .hero__inner {
    padding-block: 64px 32px;
  }

  .display {
    max-inline-size: 14ch;
    margin-block: 16px;
  }

  :lang(ar) .display {
    max-inline-size: 18ch;
  }

  .lede {
    font-size: 1.25rem;
    color: var(--color-muted);
  }

  .ctas a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
  }

  .hero__media {
    margin-block: 0;
  }

  .hero__media :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .band {
    padding-block: 96px;
    max-inline-size: 70ch;
  }
</style>
