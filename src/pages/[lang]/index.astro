---
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ar" } }];
}

const lang = Astro.params.lang as "en" | "ar";
---

<BaseLayout title="Makeena · Phase 0" lang={lang}>
  <div class="wrap">
    <p class="label">00 · PHASE 0</p>
    <h1 class="display">Makeena.</h1>
    <p>Phase 0 scaffold. Spike pages:</p>
    <ul>
      <li>
        <a href={`/${lang}/spike/aerial/`}>03 · Scroll-flown aerial</a>
      </li>
      <li>
        <a href={`/${lang}/spike/home/`}>11 · Section-cut page transition</a> (navigate Home ⇄
        Method)
      </li>
      <li>
        <a href={`/${lang}/spike/method/`}>12 · Mirror-line language switch</a> (use the language
        link)
      </li>
    </ul>
  </div>
</BaseLayout>
