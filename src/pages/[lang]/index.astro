---
import BaseLayout from "../../layouts/BaseLayout.astro";

export function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "ar" } }];
}

const lang = Astro.params.lang as "en" | "ar";
---

<BaseLayout title="Makeena · Phase 0" lang={lang}>
  <div class="wrap">
    <p class="label">00 · PHASE 0</p>
    <h1>Makeena.</h1>
    <p>Phase 0 scaffold. Spikes land on their own branches.</p>
  </div>
</BaseLayout>
