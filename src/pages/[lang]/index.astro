---
import ContactBlock from "../../components/content/ContactBlock.astro";
import OrganizationData from "../../components/content/OrganizationData.astro";
import RegisterTable from "../../components/content/RegisterTable.astro";
import FigureGrid from "../../components/media/FigureGrid.astro";
import ProvenanceFigure from "../../components/media/ProvenanceFigure.astro";
import type { Lang } from "../../i18n/config";
import Page from "../../layouts/Page.astro";
import { getPage, langPaths } from "../../lib/content";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const page = await getPage("home", lang);

// 03 teaser (PRD §5, §16): the flight's three chapter stills, at night under 13 after hours; the
// full flight is on the aerial perspective page.
const teaser = ["MKN-AER-FLT01-A", "MKN-AER-FLT01-B", "MKN-AER-FLT01-C"];
const teaserSizes =
  "(width >= 80rem) 410px, (width >= 64rem) 31vw, (width >= 48rem) 47vw, calc(100vw - 32px)";
---

<Page route="home" lang={lang}>
  <ProvenanceFigure
    slot="media"
    assetId="MKN-TWR-CAM01-DUSK"
    night="MKN-TWR-CAM01-NIGHT"
    lang={lang}
    priority
  />
  <FigureGrid slot="capability" cols={3}>
    {teaser.map((assetId) => (
      <ProvenanceFigure
        assetId={assetId}
        night={assetId.replace("FLT01-", "FLT01-NIGHT")}
        lang={lang}
        sizes={teaserSizes}
      />
    ))}
  </FigureGrid>
  <RegisterTable
    slot="studio"
    lang={lang}
    rows={["entity", "licence", "tax-id"]}
    label={lang === "ar" ? "السجل المؤسسي، باختصار" : "Corporate register, key rows"}
  />
  <Fragment slot="contact">
    <ContactBlock lang={lang} />
    <OrganizationData lang={lang} description={page.description} />
  </Fragment>
</Page>
