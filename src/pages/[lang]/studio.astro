---
import ContactBlock from "../../components/content/ContactBlock.astro";
import OrganizationData from "../../components/content/OrganizationData.astro";
import RegisterTable from "../../components/content/RegisterTable.astro";
import FigureGrid from "../../components/media/FigureGrid.astro";
import ProvenanceFigure from "../../components/media/ProvenanceFigure.astro";
import type { Lang } from "../../i18n/config";
import Page from "../../layouts/Page.astro";
import { getPage, langPaths } from "../../lib/content";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const page = await getPage("studio", lang);
---

<Page route="studio" lang={lang}>
  <FigureGrid slot="studio" cols={2}>
    <ProvenanceFigure
      assetId="MKN-STU-CAM01-CONTROL"
      lang={lang}
      priority
      sizes="(width >= 80rem) 628px, (width >= 48rem) 47vw, calc(100vw - 32px)"
    />
    <ProvenanceFigure
      assetId="MKN-STU-CAM02-RUNBOOK"
      lang={lang}
      sizes="(width >= 80rem) 628px, (width >= 48rem) 47vw, calc(100vw - 32px)"
    />
  </FigureGrid>
  <Fragment slot="register">
    <RegisterTable lang={lang} label={lang === "ar" ? "السجل المؤسسي" : "Corporate register"} />
    <OrganizationData lang={lang} description={page.description} />
  </Fragment>
  <ContactBlock slot="contact" lang={lang} />
  <Fragment slot="brief">
    <p id="brief-fixed" lang="en" dir="ltr">
      [PLACEHOLDER: brief form, engagement preset to Fixed]
    </p>
    <p id="brief-retained" lang="en" dir="ltr">
      [PLACEHOLDER: brief form, engagement preset to Retained]
    </p>
  </Fragment>
</Page>
