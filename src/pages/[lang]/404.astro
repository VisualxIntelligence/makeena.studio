---
// Localised 404 (PRD §5). Built as /{lang}/404/index.html and moved to /{lang}/404.html by the
// localized404 hook in astro.config.mjs, because Cloudflare serves the nearest 404.html.
import Label from "../../components/content/Label.astro";
import { pathTo, type Lang } from "../../i18n/config";
import { ui } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { langPaths } from "../../lib/content";

export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
const t = ui[lang].notFound;
---

<BaseLayout title={`${t.heading} · Makeena`} lang={lang} alternates={false}>
  <div class="wrap not-found">
    <Label text={t.label} lang={lang} />
    <h1 class="display">{t.heading}</h1>
    <p>{t.body}</p>
    <p>
      <a href={pathTo(lang, "home")}>{t.home}</a>
    </p>
  </div>
</BaseLayout>

<style>
  .not-found {
    padding-block: 64px;
  }
</style>
