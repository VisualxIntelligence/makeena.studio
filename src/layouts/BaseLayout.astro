---
import "../styles/base.css";
import "../styles/view-transitions.css";
import CutLine from "../components/global/CutLine.astro";

interface Props {
  title: string;
  lang: "en" | "ar";
}

const { title, lang } = Astro.props;
const dir = lang === "ar" ? "rtl" : "ltr";
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <script is:inline>
      // G2 (PRD §8.2). Inline and synchronous so it runs before the first render.
      // After an internal navigation, move focus to <main> so keyboard and
      // screen-reader users start at the new page's content.
      document.addEventListener("DOMContentLoaded", function () {
        var ref = document.referrer && new URL(document.referrer);
        if (ref && ref.origin === location.origin && !location.hash) {
          var main = document.getElementById("main");
          if (main) main.focus({ preventScroll: true });
        }
      });
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot name="header" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <CutLine />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
