---
import { Font } from "astro:assets";
import "../styles/base.css";
import "../styles/view-transitions.css";
import CutLine from "../components/global/CutLine.astro";

interface Props {
  title: string;
  lang: "en" | "ar";
}

const { title, lang } = Astro.props;
const dir = lang === "ar" ? "rtl" : "ltr";
const isAr = lang === "ar";
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <!-- Latin faces on every page (identifiers stay Latin in Arabic); Arabic faces on /ar/ only. -->
    <Font cssVariable="--font-display" preload={isAr ? false : [{ weight: 400 }]} />
    <Font cssVariable="--font-body" preload={isAr ? false : [{ weight: 400 }]} />
    <Font cssVariable="--font-mono" />
    {isAr && <Font cssVariable="--font-ar-display" preload />}
    {isAr && <Font cssVariable="--font-ar-body" preload={[{ weight: 400 }]} />}
    <script is:inline>
      // G2 (PRD §8.2). Inline and synchronous so the pagereveal listener exists
      // before the first render of the incoming page.
      (function () {
        const KEY = "mkn-vt";
        const locale = function (path) {
          return (path.match(/^\/(en|ar)\//) || [])[1];
        };

        // 12: the language switch keeps the current section and flags the
        // navigation, because Safari 18 has no navigation.activation to compare URLs.
        document.addEventListener("click", function (e) {
          const a = e.target.closest && e.target.closest("a[data-lang-switch]");
          if (!a) return;
          a.hash = location.hash;
          try {
            sessionStorage.setItem(KEY, "lang");
          } catch {
            // Storage blocked (private mode, policy): fall back to navigation.activation.
          }
        });

        addEventListener("pagereveal", function (e) {
          let flagged = false;
          try {
            flagged = sessionStorage.getItem(KEY) === "lang";
            sessionStorage.removeItem(KEY);
          } catch {
            // Storage blocked (private mode, policy): fall back to navigation.activation.
          }
          if (!e.viewTransition) return;
          const act = window.navigation && navigation.activation;
          const from = act && act.from && act.from.url;
          const isLang = from
            ? locale(new URL(from).pathname) !== locale(location.pathname)
            : flagged;
          const root = document.documentElement;
          const type = isLang ? "lang" : "nav";
          root.dataset.vt = type;
          if (e.viewTransition.types) e.viewTransition.types.add(type);
          e.viewTransition.finished.finally(function () {
            delete root.dataset.vt;
          });
        });

        // After an internal navigation, move focus to <main> so keyboard and
        // screen-reader users start at the new page's content.
        document.addEventListener("DOMContentLoaded", function () {
          const ref = document.referrer && new URL(document.referrer);
          if (ref && ref.origin === location.origin && !location.hash) {
            const main = document.getElementById("main");
            if (main) main.focus({ preventScroll: true });
          }
        });
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot name="header" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <CutLine />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }
</style>
