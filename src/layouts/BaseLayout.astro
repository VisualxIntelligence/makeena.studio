---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import "../styles/provenance.css";
import "../styles/view-transitions.css";
import CutLine from "../components/global/CutLine.astro";
import Footer from "../components/global/Footer.astro";
import Nav from "../components/global/Nav.astro";
import Toast from "../components/global/Toast.astro";
import { counterpartPath, dirOf, type Lang } from "../i18n/config";
import { ui } from "../i18n/ui";

interface Props {
  title: string;
  lang: Lang;
  description?: string;
  /** Canonical and hreflang links (PRD §7.1). Off for 404 pages, which have no counterpart. */
  alternates?: boolean;
  /** Site nav and footer. The Phase 0 spike pages bring their own header. */
  chrome?: boolean;
  /**
   * Astro <ClientRouter /> (decision 0002). Off only for the Phase 0 spike pages, which measure
   * native cross-document view transitions.
   */
  router?: boolean;
}

const { title, lang, description, alternates = true, chrome = true, router = true } = Astro.props;
const isAr = lang === "ar";
const t = ui[lang];
const path = Astro.url.pathname;
const href = (to: Lang) => new URL(counterpartPath(path, to), Astro.site).href;
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Not indexed until launch (decision 0005: makeena.studio is attached at launch). -->
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {alternates && (
      <>
        <link rel="canonical" href={new URL(path, Astro.site).href} />
        <link rel="alternate" hreflang="en" href={href("en")} />
        <link rel="alternate" hreflang="ar" href={href("ar")} />
        <link rel="alternate" hreflang="x-default" href={href("en")} />
      </>
    )}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Latin faces on every page (identifiers stay Latin in Arabic); Arabic faces on /ar/ only. -->
    <Font cssVariable="--ff-display" preload={isAr ? false : [{ weight: 400 }]} />
    <Font cssVariable="--ff-body" preload={isAr ? false : [{ weight: 400 }]} />
    <Font cssVariable="--ff-mono" />
    {isAr && <Font cssVariable="--ff-ar-display" preload />}
    {isAr && <Font cssVariable="--ff-ar-body" preload={[{ weight: 400 }]} />}
    {
      /* 11 and 12 run on the router (src/lib/transitions); browsers without view transitions
       swap the page without a simulated animation (decision 0010). */
      router && <ClientRouter fallback="swap" />
    }
    <script is:inline>
      // G2 (PRD §8.2). Inline and synchronous so the pagereveal listener exists
      // before the first render of the incoming page.
      (function () {
        const KEY = "mkn-vt";
        const locale = function (path) {
          return (path.match(/^\/(en|ar)\//) || [])[1];
        };

        // This script runs once per visit: the ClientRouter does not re-run identical inline
        // scripts, and it replaces <html> attributes on every swap. Per-page work is therefore
        // repeated on astro:after-swap.
        const perPage = function () {
          // Lets CSS tell JS-enhanced components (the menu) from their no-JS fallbacks.
          document.documentElement.classList.add("js");
          // PRD §5: remember the locale the visitor is reading, so `/` sends them back to it.
          // 13: after hours is applied before first paint, so night pages never flash day.
          try {
            localStorage.setItem("mkn-lang", document.documentElement.lang);
            if (localStorage.getItem("mkn-hours") === "night") {
              document.documentElement.dataset.hours = "night";
            }
          } catch {
            // Storage blocked: `/` falls back to the browser's language preference; day hours.
          }
        };
        perPage();

        // After a routed navigation, move focus to <main> (unless a #section was requested) so
        // keyboard and screen-reader users start at the new page's content.
        let routed = false;
        document.addEventListener("astro:after-swap", function () {
          perPage();
          routed = true;
          try {
            sessionStorage.removeItem(KEY);
          } catch {
            // Storage blocked: nothing to clear.
          }
        });
        document.addEventListener("astro:page-load", function () {
          if (!routed || location.hash) return;
          const main = document.getElementById("main");
          if (main) main.focus({ preventScroll: true });
        });

        // 12: the language switch keeps the current section and flags the
        // navigation, because Safari 18 has no navigation.activation to compare URLs.
        document.addEventListener("click", function (e) {
          const a = e.target.closest && e.target.closest("a[data-lang-switch]");
          if (!a) return;
          a.hash = location.hash;
          try {
            sessionStorage.setItem(KEY, "lang");
          } catch {
            // Storage blocked (private mode, policy): fall back to navigation.activation.
          }
        });

        addEventListener("pagereveal", function (e) {
          let flagged = false;
          try {
            flagged = sessionStorage.getItem(KEY) === "lang";
            sessionStorage.removeItem(KEY);
          } catch {
            // Storage blocked (private mode, policy): fall back to navigation.activation.
          }
          if (!e.viewTransition) return;
          const act = window.navigation && navigation.activation;
          const from = act && act.from && act.from.url;
          const isLang = from
            ? locale(new URL(from).pathname) !== locale(location.pathname)
            : flagged;
          const root = document.documentElement;
          const type = isLang ? "lang" : "nav";
          root.dataset.vt = type;
          if (e.viewTransition.types) e.viewTransition.types.add(type);
          e.viewTransition.finished.finally(function () {
            delete root.dataset.vt;
          });
        });

        // Full page loads from another page on the site (no router: spike pages, reloads).
        document.addEventListener("DOMContentLoaded", function () {
          const ref = document.referrer && new URL(document.referrer);
          if (ref && ref.origin === location.origin && !location.hash) {
            const main = document.getElementById("main");
            if (main) main.focus({ preventScroll: true });
          }
        });
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skipLink}
    </a>
    {t.draftNotice && (
      <p class="draft-notice label" lang="en" dir="ltr">
        {t.draftNotice}
      </p>
    )}
    {chrome ? <Nav lang={lang} /> : <slot name="header" />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {chrome && <Footer lang={lang} />}
    {chrome && <Toast lang={lang} />}
    {router && <script>
      import "../lib/motion";
      import "../lib/motion/effects/reveal";
      import "../lib/transitions";
      import "../lib/hours";
      import "../lib/analytics";
    </script>}
    <CutLine />
  </body>
</html>

<style>
  main:focus {
    outline: none;
  }

  /* Visible on focus only; first stop for keyboard users. */
  .skip-link {
    position: absolute;
    inset-inline-start: 16px;
    inset-block-start: -100px;
    z-index: var(--z-toast);
    padding: 12px 16px;
    background: var(--color-ink);
    color: var(--color-ivory);
  }

  .skip-link:focus {
    inset-block-start: 8px;
  }

  .draft-notice {
    margin: 0;
    padding: 8px 16px;
    background: var(--color-sand);
    color: var(--color-ink);
    text-align: center;
  }
</style>
