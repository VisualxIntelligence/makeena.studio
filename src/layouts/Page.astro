---
// Page shell for the PRD §5 routes: header (label, display heading, lede) and the page's
// sections from src/content/pages, on the 12-column grid. Every section starts with its mono
// label top-start (PRD §6.3). A page adds components to a section through a slot named after the
// section id, e.g. <GateList slot="gates" />; they span the full grid. A section without a
// heading uses its label as the h2, so the outline never skips a level.
import Copy from "../components/content/Copy.astro";
import Label from "../components/content/Label.astro";
import { pathTo, type Lang, type RouteKey } from "../i18n/config";
import { getPage } from "../lib/content";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  route: RouteKey;
  lang: Lang;
}

const { route, lang } = Astro.props;
const page = await getPage(route, lang);
const extras = Object.fromEntries(
  await Promise.all(
    page.sections
      .filter((s) => Astro.slots.has(s.id))
      .map(async (s) => [s.id, await Astro.slots.render(s.id)] as const),
  ),
);
---

<BaseLayout title={page.title} description={page.description} lang={lang}>
  <header class="wrap grid-12 page-header">
    <Label text={page.label} lang={lang} />
    <h1 class="display">{page.heading}</h1>
    {page.lede && <p class="page-header__lede">{page.lede}</p>}
  </header>
  {page.sections.map((s) => (
    <section class="section" id={s.id} aria-labelledby={`${s.id}-label`}>
      <div class="wrap grid-12">
        <Label text={s.label} lang={lang} id={`${s.id}-label`} as={s.heading ? "p" : "h2"} />
        {s.heading && <h2>{s.heading}</h2>}
        {s.body.map((text) => (
          <p class="page-section__body">
            <Copy text={text} lang={lang} />
          </p>
        ))}
        {extras[s.id] && (
          <div class="page-section__extras">
            <Fragment set:html={extras[s.id]} />
          </div>
        )}
        {s.links.length > 0 && (
          <ul class="page-section__links">
            {s.links.map((l) => (
              <li>
                <a href={pathTo(lang, l.route, l.hash)}>
                  <Copy text={l.text} lang={lang} />
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .grid-12 > :global(*) {
    grid-column: 1 / -1;
  }

  .page-header {
    padding-block: var(--section-space);
  }

  .page-header :global(.label),
  .section :global(.label) {
    margin-block: 0 16px;
  }

  @media (width >= 48rem) {
    h1 {
      grid-column: 1 / span 11;
    }

    h2 {
      grid-column: 1 / span 9;
    }

    .page-header__lede,
    .page-section__body {
      grid-column: 1 / span 7;
    }
  }

  .page-header__lede {
    margin-block-start: 24px;
    font-size: 1.25em;
    color: var(--color-muted);
  }

  h2 {
    margin-block: 0 24px;
    font-size: clamp(1.75rem, 3.5vw, 2.75rem);
    line-height: 1.15;
  }

  /* Amiri needs 1.3–1.4 (PRD §6.2). */
  :lang(ar) h2 {
    line-height: 1.4;
  }

  .page-section__body {
    max-inline-size: var(--container-measure);
    margin-block: 0 16px;
  }

  .page-section__extras {
    margin-block-start: 16px;
  }

  .page-section__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 32px;
    margin-block-start: 16px;
    padding: 0;
    list-style: none;
  }

  .page-section__links a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
  }
</style>
