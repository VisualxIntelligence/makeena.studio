---
// Page shell for the PRD §5 routes: header (label, display heading, lede) and the page's
// sections from src/content/pages. A page adds components to a section through a slot named
// after the section id, e.g. <GateList slot="gates" />. Layout and spacing are provisional
// until phase-1/layout-nav-footer.
import Copy from "../components/content/Copy.astro";
import Label from "../components/content/Label.astro";
import { pathTo, type Lang, type RouteKey } from "../i18n/config";
import { getPage } from "../lib/content";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  route: RouteKey;
  lang: Lang;
}

const { route, lang } = Astro.props;
const page = await getPage(route, lang);
const extras = Object.fromEntries(
  await Promise.all(
    page.sections
      .filter((s) => Astro.slots.has(s.id))
      .map(async (s) => [s.id, await Astro.slots.render(s.id)] as const),
  ),
);
---

<BaseLayout title={page.title} description={page.description} lang={lang}>
  <header class="wrap page-header">
    <Label text={page.label} lang={lang} />
    <h1 class="display">{page.heading}</h1>
    {page.lede && <p class="page-header__lede">{page.lede}</p>}
  </header>
  {page.sections.map((s) => (
    <section class="wrap page-section" id={s.id} aria-labelledby={`${s.id}-label`}>
      <Label text={s.label} lang={lang} id={`${s.id}-label`} />
      {s.heading && <h2>{s.heading}</h2>}
      {s.body.map((text) => (
        <p class="page-section__body">
          <Copy text={text} lang={lang} />
        </p>
      ))}
      {extras[s.id] && <Fragment set:html={extras[s.id]} />}
      {s.links.length > 0 && (
        <ul class="page-section__links">
          {s.links.map((l) => (
            <li>
              <a href={pathTo(lang, l.route, l.hash)}>
                <Copy text={l.text} lang={lang} />
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  ))}
</BaseLayout>

<style>
  .page-header {
    padding-block: 64px 32px;
  }

  .page-header__lede {
    max-inline-size: var(--container-measure);
    margin-block-start: 16px;
    color: var(--color-muted);
  }

  .page-section {
    padding-block: 32px;
    border-block-start: 1px solid color-mix(in srgb, var(--color-ink) 15%, transparent);
  }

  h2 {
    max-inline-size: 30ch;
    margin-block: 8px 16px;
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    line-height: 1.2;
  }

  /* Amiri needs 1.3–1.4 (PRD §6.2). */
  :lang(ar) h2 {
    line-height: 1.4;
  }

  .page-section__body {
    max-inline-size: var(--container-measure);
    margin-block-end: 12px;
  }

  .page-section__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 24px;
    padding: 0;
    list-style: none;
  }

  .page-section__links a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
  }
</style>
