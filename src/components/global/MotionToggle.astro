---
// Footer control for G1 (PRD §8.1): turns site motion off on top of the OS setting, stored in
// localStorage. Hidden without JS, where there is no motion to turn off.
import type { Lang } from "../../i18n/config";
import { ui } from "../../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<button class="motion-toggle" type="button" aria-pressed="false" data-motion-toggle hidden>
  {ui[lang].reduceMotion}
</button>

<script>
  import { onPage } from "../../lib/lifecycle";
  import { motion } from "../../lib/motion";

  onPage((signal) => {
    const button = document.querySelector<HTMLButtonElement>("[data-motion-toggle]");
    if (!button) return;
    const sync = () => button.setAttribute("aria-pressed", String(motion.userMotionOff()));
    sync();
    button.hidden = false;
    button.addEventListener(
      "click",
      () => {
        motion.setUserMotionOff(!motion.userMotionOff());
        sync();
      },
      { signal },
    );
  });
</script>

<style>
  .motion-toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-block-size: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-copper-deep);
    font: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
    cursor: pointer;

    &::before {
      content: "";
      inline-size: 10px;
      block-size: 10px;
      border: 1px solid currentcolor;
      border-radius: var(--radius-xs);
    }

    &[aria-pressed="true"]::before {
      background: currentcolor;
    }
  }
</style>
