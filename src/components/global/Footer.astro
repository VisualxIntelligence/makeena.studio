---
// Footer on every page (PRD §5, UX doc §3.8): the mono legal line at the start; Entity, Privacy,
// language switch, the motion control (G1) and © at the end; ivory with a top rule. The
// keyboard-shortcut and after-hours toggles arrive with 13 in Phase 2.
import { getEntry } from "astro:content";
import { pathTo, type Lang } from "../../i18n/config";
import { ui } from "../../i18n/ui";
import LanguageSwitch from "./LanguageSwitch.astro";
import MotionToggle from "./MotionToggle.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const site = (await getEntry("site", "site"))!.data;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap site-footer__bar">
    <p class="label site-footer__legal" lang="en" dir="ltr">
      {site.legalLine}
    </p>
    <nav aria-label={t.footerNav}>
      <ul>
        <li>
          <a href={pathTo(lang, "studio", "register")}>{t.entity}</a>
        </li>
        <li>
          <a href={pathTo(lang, "privacy")}>{t.privacy}</a>
        </li>
        <li>
          <LanguageSwitch lang={lang} />
        </li>
        <li>
          <MotionToggle lang={lang} />
        </li>
        <li class="site-footer__rights">
          <span dir="ltr">
            © {year} {site.copyrightHolder}
          </span>
          <span class="visually-hidden">{t.rights}</span>
        </li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-block-start: var(--rule);
  }

  .site-footer__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 32px;
    padding-block: 16px;
  }

  .site-footer__legal {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
  }

  .site-footer__rights {
    color: var(--color-muted);
  }
</style>
