---
// One asset inside a ProvenanceFigure (08): picture, ⓘ button, caption and spec sheet. A figure
// has a day variant and, for 13 after hours, optionally a night one.
import { Picture } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { Lang } from "../../i18n/config";
import { imageFor, nextSheetId } from "../../lib/assets";
import InfoButton from "./InfoButton.astro";
import ProvenanceSheet from "./ProvenanceSheet.astro";

interface Props {
  asset: CollectionEntry<"assets">["data"];
  variant: "day" | "night";
  lang: Lang;
  sizes: string;
  widths: number[];
  priority: boolean;
  caption: boolean;
}

const { asset, variant, lang, sizes, widths, priority, caption } = Astro.props;
const sheetId = nextSheetId(asset.id);
---

<div class="pfig__variant" data-variant={variant} data-provenance={asset.id}>
  <div class="pfig__media">
    <Picture
      src={imageFor(asset)}
      alt={asset.alt[lang]}
      widths={widths}
      sizes={sizes}
      formats={["avif", "webp"]}
      loading={priority ? "eager" : "lazy"}
      fetchpriority={priority ? "high" : "auto"}
      decoding={priority ? "sync" : "async"}
    />
    <span class="pfig__corners" aria-hidden="true"></span>
    <InfoButton sheet={sheetId} assetId={asset.id} lang={lang} />
  </div>
  {caption && (
    <figcaption class="label pfig__caption" lang={lang} dir={lang === "ar" ? "rtl" : "ltr"}>
      {asset.caption[lang]}
    </figcaption>
  )}
  <ProvenanceSheet asset={asset} lang={lang} id={sheetId} />
</div>
