---
// 08 · ProvenanceFigure (PRD §8.3). Every image, sequence and video on the site goes through
// this component with an asset ID from the `assets` collection; tests/e2e/provenance.spec.ts
// fails on any media outside it.
// - Responsive AVIF/WebP via <Picture>, with explicit dimensions (no layout shift).
// - Copper corner brackets on hover and keyboard focus (CSS only).
// - A real ⓘ button opens a native popover with the spec sheet: works with mouse, touch,
//   keyboard and screen readers; Esc and a click outside close it.
// - The mono caption under the image states provenance.
// Web derivatives lose XMP, so the sheet only ever speaks of the master file (CLAUDE.md). The
// generator (service, job ID) is internal and never shown (decision 0010).
// - `night`: a second asset shown under 13 after hours (html[data-hours="night"]). It is lazy and
//   hidden until then, so browsers only fetch it once after hours is switched on.
import type { Lang } from "../../i18n/config";
import { getAsset } from "../../lib/assets";
import ProvenanceVariant from "./ProvenanceVariant.astro";

interface Props {
  assetId: string;
  /** Night variant for 13 after hours. */
  night?: string;
  lang: Lang;
  /** `sizes` for the responsive image; defaults to the full content width. */
  sizes?: string;
  widths?: number[];
  /**
   * The page's likely LCP image (PRD §13): eager, high fetch priority. Set it on the first figure
   * of a page when that figure can be in the first viewport on a phone; at most one per page.
   */
  priority?: boolean;
  caption?: boolean;
  class?: string;
}

const {
  assetId,
  night,
  lang,
  sizes = "(width >= 80rem) 1280px, calc(100vw - 32px)",
  widths = [480, 828, 1200, 1600],
  priority = false,
  caption = true,
  class: className,
} = Astro.props;

const day = await getAsset(assetId);
const nightAsset = night ? await getAsset(night) : undefined;
const shared = { lang, sizes, widths, caption };
---

<figure class:list={["pfig", className]} data-provenance={day.id} data-night={nightAsset?.id}>
  <ProvenanceVariant asset={day} variant="day" priority={priority} {...shared} />
  {nightAsset && (
    <ProvenanceVariant asset={nightAsset} variant="night" priority={false} {...shared} />
  )}
</figure>

<style>
  .pfig {
    margin: 0;
  }

  .pfig > :global([data-variant="night"]) {
    display: none;
  }

  :global(html[data-hours="night"]) .pfig[data-night] > :global([data-variant="day"]) {
    display: none;
  }

  :global(html[data-hours="night"]) .pfig > :global([data-variant="night"]) {
    display: block;
  }
</style>
