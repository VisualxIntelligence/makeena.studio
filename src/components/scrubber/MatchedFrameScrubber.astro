---
// MatchedFrameScrubber (PRD §9.1): one camera, several matched frames, one control. The single
// entry point for every mode; each mode lives in its own file.
// - continuous (04 sun study): a range input crossfades the two nearest frames.
// - discrete (07 time-lapse): stops as a radio group, a before/after wipe, a live region.
// - scroll (03 aerial): next.
import ContinuousScrubber from "./ContinuousScrubber.astro";
import DiscreteScrubber from "./DiscreteScrubber.astro";
import type { ContinuousProps, DiscreteProps } from "./types";

type Props = ContinuousProps | DiscreteProps;

const props = Astro.props;
---

{props.mode === "continuous" ? <ContinuousScrubber {...props} /> : <DiscreteScrubber {...props} />}
