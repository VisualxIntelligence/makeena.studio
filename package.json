{
  "name": "makeena-website",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:classes && npm run format:check",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.{css,astro}\"",
    "lint:classes": "node scripts/lint/tailwind-classes.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test:unit": "vitest run",
    "test:e2e": "playwright test tests/e2e",
    "test:spikes": "cross-env MKN_SPIKES=1 astro build && playwright test tests/spikes",
    "budget": "node scripts/budget/check.mjs",
    "lighthouse": "npx --yes @lhci/cli@0.15.1 autorun",
    "sequences:placeholder": "node scripts/sequences/placeholder-aerial.mjs",
    "fonts:arabic": "python -I scripts/fonts/subset_arabic.py"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "gsap": "^3.15.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "astro-eslint-parser": "^3.2.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "globals": "^17.13.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
